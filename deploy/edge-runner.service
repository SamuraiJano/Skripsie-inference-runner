[Unit]
Description=Edge Runner NCNN inference service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=/var/lib/edge-runner
ExecStart=/opt/edge-runner/bin/edge_runner --host 0.0.0.0 --port 8080 --data /var/lib/edge-runner/models --static /opt/edge-runner/frontend
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/edge-runner
MemoryMax=1600M
TasksMax=48

[Install]
WantedBy=multi-user.target

