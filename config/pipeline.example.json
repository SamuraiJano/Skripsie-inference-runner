{
  "models": {
    "yolo26n_model_id": "",
    "segmentation_model_id": "",
    "yolo26n_model_path": "models/yolo26n-detect",
    "segmentation_model_path": "models/yolo26n-seg"
  },
  "detection": {
    "confidence_threshold": 0.25,
    "iou_threshold": 0.5,
    "naartjie_class_id": 0
  },
  "bytetrack": {
    "high_threshold": 0.5,
    "low_threshold": 0.1,
    "new_track_threshold": 0.65,
    "match_iou": 0.3,
    "max_missed_frames": 30
  },
  "zones": {
    "roi_left": { "value": 0.15, "normalized": true },
    "roi_right": { "value": 0.85, "normalized": true },
    "roi_top": { "value": 0.05, "normalized": true },
    "roi_bottom": { "value": 0.95, "normalized": true },
    "entry_zone_height": { "value": 0.12, "normalized": true },
    "exit_zone_height": { "value": 0.12, "normalized": true }
  },
  "tracking": {
    "strict_entry_gating": false,
    "roi_boundary_tolerance_ratio": 0.02,
    "minimum_bbox_width_ratio": 0.025,
    "minimum_bbox_height_ratio": 0.025,
    "minimum_bbox_area_ratio": 0.003,
    "maximum_bbox_area_ratio": 0.25,
    "maintenance_size_tolerance": 0.5,
    "minimum_confirmation_hits": 3,
    "motion_window_frames": 6,
    "minimum_downward_displacement_ratio": 0.003,
    "maximum_upward_displacement_ratio": 0.01,
    "stationary_tolerance_ratio": 0.002,
    "maximum_stationary_frames": 12,
    "debug_diagnostics": false
  },
  "capture": {
    "target_capture_percentages": [0.2, 0.4, 0.6, 0.8],
    "target_views": 4,
    "minimum_frame_gap": 2,
    "crop_margin": 0.08,
    "sharpness_threshold": 60.0,
    "minimum_crop_width": 32,
    "minimum_crop_height": 32,
    "maximum_permitted_overlap": 0.25
  },
  "segmentation": {
    "queue_size": 16,
    "workers": 2
  },
  "classification": {
    "stationary_delay_seconds": 0.1,
    "timeout_seconds": 2.0,
    "minimum_views": 2,
    "confidence_threshold": 0.55
  },
  "retention": {
    "stale_track_frames": 30,
    "release_after_seconds": 5.0
  },
  "output": {
    "results_directory": "data/results",
    "logging_directory": "data/logs",
    "debug_save_images": false
  },
  "windows": {
    "cpu_threads": 8,
    "live_max_fps": 30
  },
  "surface_mapping": {
    "enabled": true,
    "shape_model": "oblate",
    "robust_shape_fit": false,
    "rotation_primary_axis": "y",
    "rotation_direction": 1,
    "candidate_frame_stride": 2,
    "maximum_candidate_views": 30,
    "maximum_mapping_views": 20,
    "minimum_mapping_views": 8,
    "preferred_step_degrees": 24.0,
    "maximum_step_degrees": 40.0,
    "rotation_search_step_degrees": 1.0,
    "secondary_axis_limit_degrees": 10.0,
    "downsample_factor": 4,
    "texture_percentile": 97.0,
    "maximum_texture_points": 80,
    "minimum_texture_points": 20,
    "minimum_valid_point_fraction": 0.45,
    "latitude_limit_degrees": 60.0,
    "pre_roll_degrees": 45.0,
    "post_roll_degrees": 45.0,
    "target_coverage_degrees": 350.0,
    "minimum_confident_coverage": 300.0,
    "maximum_map_width": 1600,
    "moment_coordinate_stride": 4,
    "spherical_tolerance": 0.06,
    "minimum_detection_confidence": 0.25,
    "minimum_focus_score": 35.0,
    "minimum_mask_area_ratio": 0.35,
    "maximum_mask_area_ratio": 0.92,
    "maximum_secondary_component_ratio": 0.12,
    "silhouette_border_pixels": 3,
    "morphological_closing_pixels": 5,
    "maximum_center_shift_ratio": 0.22,
    "maximum_scale_change_ratio": 0.30,
    "minimum_observed_area_ratio": 0.55,
    "alignment_confidence_threshold": 0.18,
    "minimum_reliable_pair_ratio": 0.65,
    "defect_probability_threshold": 0.50
  }
}
