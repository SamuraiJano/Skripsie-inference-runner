{
  "models": {
    "yolo26n_model_id": "",
    "segmentation_model_id": "",
    "yolo26n_model_path": "models/yolo26n-detect",
    "segmentation_model_path": "models/yolo26n-seg"
  },
  "detection": {
    "confidence_threshold": 0.25,
    "iou_threshold": 0.5,
    "naartjie_class_id": 0
  },
  "bytetrack": {
    "high_threshold": 0.5,
    "low_threshold": 0.1,
    "match_iou": 0.3,
    "max_missed_frames": 30
  },
  "zones": {
    "acquisition_zone_start_x": { "value": 0.1, "normalized": true },
    "classification_line_x": { "value": 0.75, "normalized": true },
    "post_classification_zone": { "value": 0.95, "normalized": true }
  },
  "capture": {
    "target_capture_percentages": [0.2, 0.4, 0.6, 0.8],
    "target_views": 4,
    "minimum_frame_gap": 2,
    "crop_margin": 0.1,
    "sharpness_threshold": 60.0,
    "minimum_crop_width": 32,
    "minimum_crop_height": 32,
    "maximum_permitted_overlap": 0.25
  },
  "segmentation": {
    "queue_size": 16,
    "workers": 2
  },
  "classification": {
    "stationary_delay_seconds": 0.1,
    "timeout_seconds": 2.0,
    "minimum_views": 2,
    "confidence_threshold": 0.55
  },
  "retention": {
    "stale_track_frames": 45,
    "release_after_seconds": 5.0
  },
  "output": {
    "results_directory": "data/results",
    "logging_directory": "data/logs",
    "debug_save_images": false
  },
  "windows": {
    "cpu_threads": 8,
    "live_max_fps": 30
  }
}
